import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProjectCheck from '../components/ProjectCheck.astro';
import Gallery from '../components/Gallery.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import CareerTeaser from '../components/CareerTeaser.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout 
  title="Hörnschemeyer + Riepe | Garten- & Landschaftsbau Osnabrück" 
  description="HÖRNSCHEMEYER u. RIEPE Garten - Landschaftsbau GmbH in Osnabrück. Ihr Meisterbetrieb für Gartenneuanlage, Pflasterarbeiten, Zaunbau, Erdarbeiten & Baumpflege."
  activeNav="home"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Trust & Stats Bar -->
  <Stats />

  <!-- Services Overview -->
  <ServicesGrid />

  <!-- Interactive Project Fast-Configurator -->
  <ProjectCheck />

  <!-- Portfolio & Reference Gallery -->
  <Gallery />

  <!-- 4-Steps Process -->
  <Process />

  <!-- About Company & Team -->
  <About />

  <!-- Career Teaser -->
  <CareerTeaser />

  <!-- FAQ Accordion -->
  <Faq />

  <!-- Contact & Map Section -->
  <ContactSection />
</Layout>
