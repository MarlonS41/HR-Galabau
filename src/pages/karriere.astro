---
import Layout from '../layouts/Layout.astro';
import CareerCard from '../components/CareerCard.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<Layout 
  title="Karriere & Jobs | Wir suchen dich! | Hörnschemeyer + Riepe Galabau" 
  description="Werde Teil unseres Teams bei HÖRNSCHEMEYER u. RIEPE Garten - Landschaftsbau GmbH in Osnabrück. Offene Stellen für Landschaftsgärtner, Vorarbeiter und Helfer."
  activeNav="karriere"
>
  <!-- Page Banner -->
  <section class="hero" style="padding: 3.5rem 0 4.5rem;">
    <div class="container text-center" style="max-width: 800px; margin: 0 auto; text-align: center;">
      <span class="hero-badge">Jobs & Ausbildung</span>
      <h1 class="hero-title" style="margin-top: 1rem;">Wir suchen dich!</h1>
      <p class="hero-lead" style="margin-bottom: 0;">
        Du suchst einen Job an der frischen Luft mit modernen Maschinen, abwechslungsreichen Projekten und einem familiären Team? Bewirb dich jetzt unkompliziert bei uns!
      </p>
    </div>
  </section>

  <!-- Visual Banner & Perks -->
  <section class="section">
    <div class="container">
      <div class="about-grid" style="margin-bottom: 4rem;">
        <div>
          <CareerCard />
        </div>
        <div>
          <span class="section-badge">Warum Hörnschemeyer + Riepe?</span>
          <h2>Deine Vorteile bei uns im Team</h2>
          <p>
            Bei uns bist du keine Nummer, sondern ein wichtiges Mitglied unseres Betriebs. Wir legen großen Wert auf Zusammenhalt, gute Ausrüstung und echte Wertschätzung für dein Handwerk.
          </p>

          <div class="about-check-list" style="margin: 1.5rem 0 2rem;">
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Attraktive, übertarifliche & pünktliche Bezahlung</span>
            </div>
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Moderner Fuhrpark (neue Bagger, Radlader & Spezialgeräte)</span>
            </div>
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Familiäre Atmosphäre mit gegenseitigem Respekt</span>
            </div>
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Geregelte Arbeitszeiten ohne endlose Überstunden</span>
            </div>
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Hochwertige Arbeits- und Schutzkleidung gestellt</span>
            </div>
            <div class="about-check-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Weiterbildungs- und Führerschein-Unterstützung</span>
            </div>
          </div>

          <a href="#bewerbung" class="btn btn-primary btn-lg">In 60 Sekunden bewerben →</a>
        </div>
      </div>

      <!-- Open Job Positions -->
      <div class="section-header" style="margin-top: 3rem;">
        <span class="section-badge">Offene Stellen</span>
        <h2 class="section-title">Aktuelle Jobangebote in Osnabrück</h2>
        <p class="section-subtitle">
          Wähle deine passende Position oder bewirb dich gerne auch initiativ.
        </p>
      </div>

      <div class="job-cards-list">
        <!-- Job 1 -->
        <div class="job-card">
          <div>
            <h3>Landschaftsgärtner / Gärtner (m/w/d)</h3>
            <p style="margin: 0.5rem 0;">Für Neuanlagen, Pflasterarbeiten, Zaunbau und Pflanzungen auf Baustellen in Osnabrück & Region.</p>
            <div class="job-tags">
              <span class="job-tag">Vollzeit</span>
              <span class="job-tag">Unbefristet</span>
              <span class="job-tag">Ab sofort</span>
            </div>
          </div>
          <a href="#bewerbung" class="btn btn-secondary">Jetzt bewerben</a>
        </div>

        <!-- Job 2 -->
        <div class="job-card">
          <div>
            <h3>Vorarbeiter / Baustellenleiter Galabau (m/w/d)</h3>
            <p style="margin: 0.5rem 0;">Verantwortung für Bauabläufe, Mitarbeiterführung vor Ort und direkte Kundenabstimmung.</p>
            <div class="job-tags">
              <span class="job-tag">Vollzeit</span>
              <span class="job-tag">Führungsposition</span>
              <span class="job-tag">Top Gehalt</span>
            </div>
          </div>
          <a href="#bewerbung" class="btn btn-secondary">Jetzt bewerben</a>
        </div>

        <!-- Job 3 -->
        <div class="job-card">
          <div>
            <h3>Helfer im Garten- und Landschaftsbau (m/w/d)</h3>
            <p style="margin: 0.5rem 0;">Auch für Quereinsteiger mit handwerklichem Geschick und Freude an der Arbeit im Freien.</p>
            <div class="job-tags">
              <span class="job-tag">Vollzeit / Teilzeit</span>
              <span class="job-tag">Quereinstieg möglich</span>
            </div>
          </div>
          <a href="#bewerbung" class="btn btn-secondary">Jetzt bewerben</a>
        </div>

        <!-- Job 4 -->
        <div class="job-card">
          <div>
            <h3>Auszubildender zum Landschaftsgärtner (m/w/d)</h3>
            <p style="margin: 0.5rem 0;">Starte deine fundierte Ausbildung in einem vielseitigen Meisterbetrieb mit besten Zukunftschancen.</p>
            <div class="job-tags">
              <span class="job-tag">Ausbildung</span>
              <span class="job-tag">Ausbildungsstart 2026/2027</span>
            </div>
          </div>
          <a href="#bewerbung" class="btn btn-secondary">Jetzt bewerben</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Direct Application Contact Section -->
  <section class="section section-subtle" id="bewerbung">
    <div class="container" style="max-width: 800px;">
      <div class="contact-form-wrap" style="text-align: center;">
        <span class="section-badge">Direkt kontaktieren</span>
        <h2 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">Interesse am Job? Ruf uns an oder schreib uns!</h2>
        <p style="margin-bottom: 2rem;">
          Kein Formular, kein Anschreiben, kein Lebenslauf nötig. Melde dich einfach direkt bei Jonas Hörnschemeyer für ein kurzes, unkompliziertes Kennenlernen.
        </p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="tel:+4917646550964" class="btn btn-primary btn-lg">
            📱 0176 / 4655 0964 anrufen
          </a>
          <a href="https://wa.me/4917646550964?text=Hallo%20Jonas,%20ich%20habe%20Interesse%20an%20einem%20Job%20bei%20euch!" class="btn btn-secondary btn-lg" target="_blank" rel="noopener">
            💬 WhatsApp schreiben
          </a>
          <a href="mailto:info@hr-galabau.com" class="btn btn-outline btn-lg">
            ✉️ E-Mail senden
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
