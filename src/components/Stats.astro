---
// Stats Component
---
<section class="stats-bar">
  <div class="container stats-grid">
    <div class="stat-card">
      <div class="stat-icon">🌿</div>
      <div>
        <div class="stat-number" data-target="100" data-suffix="%">100%</div>
        <div class="stat-label">Leidenschaft & Fachkompetenz</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🏡</div>
      <div>
        <div class="stat-number" data-target="250" data-prefix="+" data-suffix="">+250</div>
        <div class="stat-label">Erfolgreich realisierte Projekte</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🚜</div>
      <div>
        <div class="stat-number" data-target="1" data-suffix=" Hand">1 Hand</div>
        <div class="stat-label">Von Konzeption bis Fertigstellung</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📍</div>
      <div>
        <div class="stat-number" data-target="49090" data-prefix="PLZ ">PLZ 49090</div>
        <div class="stat-label">Osnabrück & umliegende Region</div>
      </div>
    </div>
  </div>
</section>
