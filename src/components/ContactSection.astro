---
interface Props {
  selectedService?: string;
}

const { selectedService = 'allgemein' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---
<section class="section" id="kontakt">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Kontakt & Beratung</span>
      <h2 class="section-title">Lassen Sie uns über Ihr Gartenprojekt sprechen</h2>
      <p class="section-subtitle">
        Rufen Sie uns direkt an oder senden Sie uns eine Nachricht – wir freuen uns auf Sie!
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Info Box -->
      <div class="contact-info-card">
        <div>
          <h3 style="color: #fff; margin-bottom: 0.5rem;">HÖRNSCHEMEYER u. RIEPE</h3>
          <p style="color: var(--accent-lime); font-weight: 700; font-size: 0.9rem;">Garten - Landschaftsbau GmbH</p>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <div class="contact-info-icon">📍</div>
              <div class="contact-info-text">
                <h4>Anschrift & Standort</h4>
                <p>Moorweg 61<br />49090 Osnabrück</p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-info-icon">📞</div>
              <div class="contact-info-text">
                <h4>Telefon Büro</h4>
                <p><a href="tel:054072585">05407 / 2585</a></p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-info-icon">📱</div>
              <div class="contact-info-text">
                <h4>Mobil & WhatsApp</h4>
                <p><a href="tel:+4917646550964">+49 176 4655 0964</a></p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-info-icon">✉️</div>
              <div class="contact-info-text">
                <h4>E-Mail</h4>
                <p><a href="mailto:info@hr-galabau.com">info@hr-galabau.com</a></p>
              </div>
            </div>
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.08); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.12);">
          <div style="font-size: 0.85rem; color: #fff; font-weight: 600; margin-bottom: 0.25rem;">🕒 Büro- & Beratungszeiten</div>
          <div style="font-size: 0.85rem; color: var(--text-inverse-muted);">Mo. – Fr.: 07:00 – 17:00 Uhr<br />Samstag: Nach Vereinbarung</div>
        </div>
      </div>

      <!-- Contact Direct Action Card -->
      <div class="contact-form-wrap" style="display: flex; flex-direction: column; justify-content: center;">
        <h3 style="margin-bottom: 0.5rem;">Direkt Kontakt aufnehmen</h3>
        <p style="margin-bottom: 2rem; font-size: 0.95rem;">
          Wir beraten Sie gerne persönlich zu Ihrem Vorhaben. Nutzen Sie einen unserer direkten Kontaktwege:
        </p>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <a href="tel:054072585" class="btn btn-primary btn-lg" style="justify-content: center; gap: 0.75rem;">
            <span>📞 Büro anrufen: 05407 / 2585</span>
          </a>

          <a href="tel:+4917646550964" class="btn btn-secondary btn-lg" style="justify-content: center; gap: 0.75rem;">
            <span>📱 Mobil: +49 176 4655 0964</span>
          </a>

          <a href="https://wa.me/4917646550964?text=Hallo%20H%C3%B6rnschemeyer%20%2B%20Riepe%20Team,%20ich%20habe%20eine%20Anfrage%20zu%20einem%20Gartenprojekt." class="btn btn-outline btn-lg" target="_blank" rel="noopener" style="justify-content: center; gap: 0.75rem;">
            <span>💬 Per WhatsApp schreiben</span>
          </a>

          <a href="mailto:info@hr-galabau.com" class="btn btn-outline btn-lg" style="justify-content: center; gap: 0.75rem;">
            <span>✉️ E-Mail senden: info@hr-galabau.com</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Map Embed -->
    <div class="map-container">
      <iframe 
        title="Standort von Hörnschemeyer + Riepe Garten-Landschaftsbau GmbH"
        src="https://www.openstreetmap.org/export/embed.html?bbox=7.9944,52.3112,8.0444,52.3312&amp;layer=mapnik&amp;marker=52.3212,8.0194"
        loading="lazy">
      </iframe>
    </div>
  </div>
</section>
