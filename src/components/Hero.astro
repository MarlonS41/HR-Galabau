---
// Hero Component
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---
<section class="hero">
  <img src={`${baseUrl}/assets/images/tree.svg`} alt="" class="hero-tree-bg" aria-hidden="true" />
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-badge-row">
        <span class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Garten- & Landschaftsbau in Osnabrück
        </span>
        <span class="hero-badge">
          ✨ Alles im grünen Bereich
        </span>
      </div>

      <h1 class="hero-title">
        Ihr Fachbetrieb für individuelle <span class="text-gradient">Traumgärten</span> & moderne Außenanlagen
      </h1>

      <p class="hero-lead">
        Von der ersten Planung über fachgerechte Pflaster- und Zaunbauarbeiten bis hin zur kompletten Neuanlage und Pflege: <strong>Hörnschemeyer + Riepe</strong> realisiert Außenbereiche mit Präzision, Leidenschaft und modernstem Maschinenpark.
      </p>

      <div class="hero-actions">
        <a href={`${baseUrl}/kontakt`} class="btn btn-primary btn-lg">
          Kostenlose Erstberatung sichern
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href={`${baseUrl}/referenzen`} class="btn btn-outline-white btn-lg">
          Projekte ansehen
        </a>
      </div>

      <div class="hero-trust-list">
        <div class="hero-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Höchste Qualitätsstandards</span>
        </div>
        <div class="hero-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
          <span>Verlässliche Termintreue</span>
        </div>
        <div class="hero-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Persönliche Beratung vor Ort</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual Card -->
    <div class="hero-visual">
      <div class="hero-card-main">
        <img src={`${baseUrl}/assets/images/1.jpg`} alt="Exklusive Gartenanlage von Hörnschemeyer und Riepe" />
        <div class="hero-float-badge">
          <span class="hero-float-badge-pulse"></span>
          Termine für 2026/2027 verfügbar
        </div>
        <div class="hero-card-overlay">
          <h4 style="color: #fff; margin-bottom: 0.25rem;">Gartenneuanlage & Terrassengestaltung</h4>
          <p style="color: #b9d8c2; font-size: 0.88rem; margin: 0;">Präzise Handwerkskunst & maßgeschneiderte Pflanzkonzepte</p>
        </div>
      </div>
    </div>
  </div>
</section>
