---
interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container header-inner">
    <a href={`${baseUrl}/`} class="brand-logo" title="Hörnschemeyer + Riepe Galabau">
      <img src={`${baseUrl}/assets/images/logo_dark.svg`} alt="Hörnschemeyer + Riepe Logo" />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" id="navLinks">
      <a href={`${baseUrl}/`} class={`nav-link ${activeNav === 'home' ? 'active' : ''}`}>Startseite</a>
      <a href={`${baseUrl}/leistungen`} class={`nav-link ${activeNav === 'leistungen' ? 'active' : ''}`}>Leistungen</a>
      <a href={`${baseUrl}/referenzen`} class={`nav-link ${activeNav === 'referenzen' ? 'active' : ''}`}>Referenzen</a>
      <a href={`${baseUrl}/#ablauf`} class="nav-link">Ablauf</a>
      <a href={`${baseUrl}/#ueber-uns`} class="nav-link">Über uns</a>
      <a href={`${baseUrl}/karriere`} class={`nav-link ${activeNav === 'karriere' ? 'active' : ''}`}>Karriere</a>
      <a href={`${baseUrl}/kontakt`} class={`nav-link ${activeNav === 'kontakt' ? 'active' : ''}`}>Kontakt</a>
    </nav>

    <!-- Fast Header Actions -->
    <div class="nav-cta">
      <a href="tel:054072585" class="nav-phone-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        05407 / 2585
      </a>
      <a href={`${baseUrl}/kontakt`} class="btn btn-primary btn-sm">Projekt anfragen</a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-toggle" aria-label="Menü öffnen" id="mobileToggleBtn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>
</header>
