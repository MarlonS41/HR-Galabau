---
interface Props {
  isFullPage?: boolean;
}

const { isFullPage = false } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---
<section class="section" id="referenzen">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Referenzen & Eindrücke</span>
      <h2 class="section-title">Ausgewählte Projekte von Hörnschemeyer + Riepe</h2>
      <p class="section-subtitle">
        Lassen Sie sich von unseren bisherigen Arbeiten in Osnabrück und Umgebung inspirieren. Klicken Sie auf ein Bild für die Großansicht.
      </p>
    </div>

    <!-- Filter Tabs -->
    <div class="gallery-filter-bar">
      <button class="filter-btn active" data-filter="all">Alle Projekte</button>
      <button class="filter-btn" data-filter="neuanlage">Neuanlagen & Gärten</button>
      <button class="filter-btn" data-filter="pflaster">Pflaster & Terrassen</button>
      <button class="filter-btn" data-filter="zaun">Zaunbau & Sichtschutz</button>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid">
      <!-- Item 1 -->
      <div class="gallery-item" data-category="neuanlage">
        <img src={`${baseUrl}/assets/images/Neubau1.jpeg`} alt="Gartenneuanlage Neubauprojekt" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Gartenneuanlage</span>
          <h4 class="gallery-item-title">Moderne Neuanlage mit Rollrasen</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 2 -->
      <div class="gallery-item" data-category="neuanlage">
        <img src={`${baseUrl}/assets/images/Neubau2.jpeg`} alt="Erdarbeiten und Pflanzbeet-Anlage" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Gartenneuanlage</span>
          <h4 class="gallery-item-title">Hangbefestigung & Bepflanzung</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 3 -->
      <div class="gallery-item" data-category="pflaster">
        <img src={`${baseUrl}/assets/images/1.jpg`} alt="Hochwertige Terrassengestaltung" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Pflaster & Terrassen</span>
          <h4 class="gallery-item-title">Terrassenanlage mit Großformatplatten</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 4 -->
      <div class="gallery-item" data-category="zaun">
        <img src={`${baseUrl}/assets/images/Zaun.jpeg`} alt="Doppelstabmattenzaun mit Sichtschutz" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Zaunbau & Sichtschutz</span>
          <h4 class="gallery-item-title">Doppelstabmattenzaun Anthrazit</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 5 -->
      <div class="gallery-item" data-category="zaun">
        <img src={`${baseUrl}/assets/images/Zaun0.jpeg`} alt="Zaunmontage mit Sichtschutzstreifen" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Zaunbau & Sichtschutz</span>
          <h4 class="gallery-item-title">Sichtschutzelemente & Einfriedung</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 6 -->
      <div class="gallery-item" data-category="pflaster">
        <img src={`${baseUrl}/assets/images/3.jpg`} alt="Wegebau und Pflasterung" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Pflaster & Terrassen</span>
          <h4 class="gallery-item-title">Einfahrt & Wegebau</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 7 -->
      <div class="gallery-item" data-category="neuanlage">
        <img src={`${baseUrl}/assets/images/Neubau4.jpeg`} alt="Gesamtkonzept für Einfamilienhaus" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Gartenneuanlage</span>
          <h4 class="gallery-item-title">Gesamtanlage Neubauprojekt</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 8 -->
      <div class="gallery-item" data-category="zaun">
        <img src={`${baseUrl}/assets/images/Zaun2.jpeg`} alt="Zaunbau Grundstücksgrenze" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Zaunbau & Sichtschutz</span>
          <h4 class="gallery-item-title">Stabile Zaunanlage & Eckverbinder</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      <!-- Item 9 -->
      <div class="gallery-item" data-category="pflaster">
        <img src={`${baseUrl}/assets/images/5.jpg`} alt="Gartenlandschaft mit Steinelementen" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-category">Pflaster & Terrassen</span>
          <h4 class="gallery-item-title">Naturstein- und Pflasterkombination</h4>
        </div>
        <div class="gallery-zoom-icon">🔍</div>
      </div>

      {isFullPage && (
        <>
          <div class="gallery-item" data-category="neuanlage">
            <img src={`${baseUrl}/assets/images/Neubau3.jpeg`} alt="Erdarbeiten und Feinplanum" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Gartenneuanlage</span>
              <h4 class="gallery-item-title">Erdarbeiten & Bodenvorbereitung</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>

          <div class="gallery-item" data-category="zaun">
            <img src={`${baseUrl}/assets/images/Zaun3.jpeg`} alt="Zaun mit Sichtschutzstreifen" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Zaunbau & Sichtschutz</span>
              <h4 class="gallery-item-title">Sichtschutzstreifen in Anthrazit</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>

          <div class="gallery-item" data-category="neuanlage">
            <img src={`${baseUrl}/assets/images/2.jpg`} alt="Gepflegte Grünanlage" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Gartenneuanlage</span>
              <h4 class="gallery-item-title">Gepflegte Gartenanlage</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>

          <div class="gallery-item" data-category="neuanlage">
            <img src={`${baseUrl}/assets/images/4.jpg`} alt="Strukturierte Gartenelemente" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Gartenneuanlage</span>
              <h4 class="gallery-item-title">Strukturierte Gartenelemente</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>

          <div class="gallery-item" data-category="neuanlage">
            <img src={`${baseUrl}/assets/images/6.jpg`} alt="Baumpflege & Begrünung" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Gartenneuanlage</span>
              <h4 class="gallery-item-title">Baumpflege & Begrünung</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>

          <div class="gallery-item" data-category="neuanlage">
            <img src={`${baseUrl}/assets/images/7.jpg`} alt="Fertiggestellte Gartenanlage" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category">Gartenneuanlage</span>
              <h4 class="gallery-item-title">Fertiggestelltes Gesamtprojekt</h4>
            </div>
            <div class="gallery-zoom-icon">🔍</div>
          </div>
        </>
      )}
    </div>

    {!isFullPage && (
      <div style="text-align: center; margin-top: 3rem;">
        <a href={`${baseUrl}/referenzen`} class="btn btn-outline">
          Alle Referenzen ansehen
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    )}
  </div>
</section>
