---
// Lightbox Component
---
<div class="lightbox-modal" id="lightboxModal" role="dialog" aria-modal="true">
  <button class="lightbox-close" aria-label="Schließen">&times;</button>
  <button class="lightbox-nav-btn lightbox-prev" aria-label="Vorheriges Bild">&#10094;</button>
  <button class="lightbox-nav-btn lightbox-next" aria-label="Nächstes Bild">&#10095;</button>
  <div class="lightbox-content">
    <img src="" alt="" class="lightbox-img" />
    <div class="lightbox-caption"></div>
  </div>
</div>
