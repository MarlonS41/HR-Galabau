---
// Footer Component
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <img src={`${baseUrl}/assets/images/footerTree.svg`} alt="" class="footer-tree-bg" aria-hidden="true" />
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Info -->
      <div class="footer-brand">
        <img src={`${baseUrl}/assets/images/logo_white.svg`} alt="Hörnschemeyer + Riepe" style="height: 46px; margin-bottom: 1rem;" />
        <p>
          HÖRNSCHEMEYER u. RIEPE Garten - Landschaftsbau GmbH ist Ihr zuverlässiger Fachbetrieb für anspruchsvollen Gartenbau, Pflasterarbeiten, Zaunanlagen und Erdarbeiten in Osnabrück und Umgebung.
        </p>
        <div style="font-weight: 700; color: var(--accent-lime); font-size: 0.95rem;">
          Alles im grünen Bereich.
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="footer-heading">Navigation</h4>
        <div class="footer-links">
          <a href={`${baseUrl}/`} class="footer-link">Startseite</a>
          <a href={`${baseUrl}/leistungen`} class="footer-link">Leistungen & Services</a>
          <a href={`${baseUrl}/referenzen`} class="footer-link">Bilder & Referenzen</a>
          <a href={`${baseUrl}/#ablauf`} class="footer-link">Projekt-Ablauf</a>
          <a href={`${baseUrl}/#ueber-uns`} class="footer-link">Über unser Unternehmen</a>
          <a href={`${baseUrl}/karriere`} class="footer-link">Karriere & Jobs</a>
          <a href={`${baseUrl}/kontakt`} class="footer-link">Kontakt & Beratung</a>
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="footer-heading">Leistungen</h4>
        <div class="footer-links">
          <a href={`${baseUrl}/leistungen#neuanlage`} class="footer-link">Gartenneuanlage</a>
          <a href={`${baseUrl}/leistungen#pflaster`} class="footer-link">Pflasterarbeiten & Terrassen</a>
          <a href={`${baseUrl}/leistungen#zaun`} class="footer-link">Zaunbau & Sichtschutz</a>
          <a href={`${baseUrl}/leistungen#erdarbeiten`} class="footer-link">Erdarbeiten & Modellierung</a>
          <a href={`${baseUrl}/leistungen#baumpflege`} class="footer-link">Baumpflege & Rodung</a>
          <a href={`${baseUrl}/leistungen#pflege`} class="footer-link">Garten- & Grünpflege</a>
        </div>
      </div>

      <!-- Contact Direct -->
      <div>
        <h4 class="footer-heading">Kontakt</h4>
        <div class="footer-contact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Moorweg 61<br />49090 Osnabrück</span>
        </div>
        <div class="footer-contact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="tel:054072585" class="footer-link">05407 / 2585</a>
        </div>
        <div class="footer-contact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="tel:+4917646550964" class="footer-link">+49 176 4655 0964</a>
        </div>
        <div class="footer-contact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <a href="mailto:info@hr-galabau.com" class="footer-link">info@hr-galabau.com</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        &copy; {new Date().getFullYear()} HÖRNSCHEMEYER u. RIEPE Garten - Landschaftsbau GmbH. Alle Rechte vorbehalten.
      </div>
      <div class="footer-legal-links">
        <a href={`${baseUrl}/impressum`}>Impressum</a>
        <a href={`${baseUrl}/datenschutz`}>Datenschutz</a>
        <a href={`${baseUrl}/karriere`}>Karriere</a>
        <a href={`${baseUrl}/kontakt`}>Kontakt</a>
      </div>
    </div>
  </div>
</footer>
